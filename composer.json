{
  "name": "catch/capture-inbox",
  "description": "Catch - Capture once. Decide later.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-sodium": "*"
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.87"
  }
}
