{
  "openapi": "3.0.3",
  "info": {
    "title": "Catch Public API",
    "version": "0.1.0-prerelease",
    "description": "The complete inventory of publicly reachable machine endpoints currently implemented by Catch. Pairing creates one device token. That token is used to submit captures for the account that owns the device.\n\n**Try it out sends real requests to the current Catch installation.** Pairing consumes a valid setup code, and capture requests store data.\n\nRoutes marked **Reserved** exist in the application, but pairing currently issues only `capture:write` tokens. Catch does not currently issue the `full` tokens required by those operations."
  },
  "externalDocs": {
    "description": "iOS Shortcut setup guide",
    "url": "/help"
  },
  "servers": [
    {
      "url": "/",
      "description": "This Catch installation"
    }
  ],
  "tags": [
    {
      "name": "Pairing",
      "description": "Pair supported clients to a scoped device token. Browser extensions use a nonce and verifier handshake; iOS Shortcuts use a setup code. There is no public device-listing API."
    },
    {
      "name": "Shortcut",
      "description": "iOS Shortcut convenience endpoints. Every response contains exactly one flat string field: `result` on success or `error` on failure."
    },
    {
      "name": "Captures",
      "description": "Versioned, client-neutral capture API."
    },
    {
      "name": "Reserved full access",
      "description": "Implemented capture-management routes that require a `full` token. No such token is currently issued through the public pairing flow."
    },
    {
      "name": "Operations",
      "description": "Unauthenticated service-health information."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Operations"],
        "summary": "Check application and database availability",
        "operationId": "getHealth",
        "description": "Public operational probe. It does not expose account data.",
        "responses": {
          "200": {
            "description": "Application process is responding.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": {
                  "status": "ok",
                  "database": "connected",
                  "time": "2026-08-08T12:00:00+00:00"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/pair": {
      "post": {
        "tags": ["Pairing"],
        "summary": "Pair any supported client",
        "operationId": "pairDevice",
        "description": "Channel-neutral pairing endpoint intended for clients such as future Android apps or browser extensions. It does **not** list or manage devices. Device creation and listing remain signed-in frontend routes under `/devices`. A pairing code contains 10 numeric digits, expires after 15 minutes, and is consumed by a successful request. The response contains the only plaintext copy of the new device token.",
        "requestBody": { "$ref": "#/components/requestBodies/PairingRequest" },
        "responses": {
          "201": {
            "description": "Device paired. Store the returned token securely.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairingResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/InvalidPairingCode" },
          "500": { "$ref": "#/components/responses/ApiFailure" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/shortcut/pair": {
      "post": {
        "tags": ["Shortcut"],
        "summary": "Pair an iOS Shortcut",
        "operationId": "pairShortcut",
        "description": "iOS-specific alias of `/api/devices/pair`. It uses the same pairing service but returns the flat Shortcut response envelope. On success, `result` is the new device token.",
        "requestBody": { "$ref": "#/components/requestBodies/PairingRequest" },
        "responses": {
          "201": {
            "description": "Device paired. `result` contains the device token.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
                "example": { "result": "catch_device_example-token" }
              }
            }
          },
          "401": {
            "description": "Pairing code is invalid, expired, or has already been consumed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
                "example": { "error": "The pairing code is invalid." }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ShortcutFailure" },
          "503": { "$ref": "#/components/responses/ShortcutDatabaseUnavailable" }
        }
      }
    },
    "/api/extension/pairing-requests": {
      "post": {
        "tags": ["Pairing"],
        "summary": "Start browser extension pairing",
        "operationId": "startExtensionPairing",
        "description": "Creates a short-lived browser pairing request. The client keeps the random verifier locally and sends only its SHA-256 base64url challenge here. Catch derives the user-facing browser/OS label from the request's ordinary User-Agent header. Open `pair_url` in a normal browser tab so the signed-in user can approve the device. No device token is placed in that URL.",
        "requestBody": { "$ref": "#/components/requestBodies/ExtensionPairingStartRequest" },
        "responses": {
          "201": {
            "description": "Pairing request created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtensionPairingStartResponse" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/ApiFailure" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/extension/pairing-requests/{request}/exchange": {
      "post": {
        "tags": ["Pairing"],
        "summary": "Poll or complete browser extension pairing",
        "operationId": "exchangeExtensionPairing",
        "description": "Proves possession of the verifier used to create the challenge. Returns HTTP 202 while user approval is pending. After approval, the response contains the only plaintext copy of the long-lived device token and consumes the pairing request.",
        "parameters": [{ "name": "request", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-f]{48}$" } }],
        "requestBody": { "$ref": "#/components/requestBodies/ExtensionPairingExchangeRequest" },
        "responses": {
          "200": {
            "description": "Browser connected. Store the returned token in extension storage.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtensionPairingResponse" } } }
          },
          "202": { "description": "The request is still waiting for user approval." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Pairing request not found." },
          "410": { "description": "Pairing request expired." },
          "500": { "$ref": "#/components/responses/ApiFailure" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/extension/disconnect": {
      "post": {
        "tags": ["Pairing"],
        "summary": "Disconnect a browser extension",
        "operationId": "disconnectExtension",
        "description": "Revokes the supplied device token by deleting its browser device. This endpoint accepts the extension's `capture:write` token.",
        "security": [{ "deviceToken": [] }],
        "responses": {
          "200": { "description": "Browser disconnected.", "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["disconnected"] } } }, "example": { "status": "disconnected" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/extension/connection": {
      "get": {
        "tags": ["Pairing"],
        "summary": "Validate a browser extension connection",
        "operationId": "validateExtensionConnection",
        "description": "Checks whether a device token still belongs to a connected browser device. Invalid and revoked tokens receive the same generic 401 response; the endpoint does not reveal token prefixes or partial matches.",
        "security": [{ "deviceToken": [] }],
        "responses": {
          "200": { "description": "The browser is still connected.", "content": { "application/json": { "schema": { "type": "object", "required": ["status", "device"], "properties": { "status": { "type": "string", "enum": ["connected"] }, "device": { "type": "object", "required": ["id", "name", "platform", "client_type"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "platform": { "type": "string" }, "client_type": { "type": "string", "enum": ["extension"] } } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/shortcut/captures": {
      "post": {
        "tags": ["Shortcut"],
        "summary": "Submit a capture from iOS Shortcuts",
        "operationId": "createShortcutCapture",
        "description": "iOS-friendly alias of `POST /api/v1/captures`. Both routes use the shared capture request documented below; multipart form data is shown first because it maps cleanly to iOS Shortcuts. For a voice-to-text Shortcut, use `type=text` and place the transcript in `text` (not `extracted_text`). On success, `result` is the user's human-facing catch number, suitable for a message such as `Stored Catch #334`. Reusing `client_capture_id` for the same account returns the existing capture instead of creating a duplicate.",
        "security": [{ "deviceToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/CaptureRequest" },
        "responses": {
          "200": {
            "description": "An idempotent retry found the existing capture. `result` contains its catch number.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
                "example": { "result": "334" }
              }
            }
          },
          "201": {
            "description": "Capture created. `result` contains its per-user catch number.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
                "example": { "result": "334" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ShortcutUnauthorized" },
          "422": { "$ref": "#/components/responses/ShortcutValidationFailed" },
          "500": { "$ref": "#/components/responses/ShortcutFailure" },
          "503": { "$ref": "#/components/responses/ShortcutDatabaseUnavailable" }
        }
      }
    },
    "/api/v1/captures": {
      "get": {
        "tags": ["Reserved full access"],
        "summary": "List captures (reserved)",
        "operationId": "listCaptures",
        "description": "Requires a `full` token. Pairing currently issues only `capture:write`, so this route is not presently usable by paired public clients.",
        "security": [{ "fullDeviceToken": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Capture status to list.",
            "schema": { "$ref": "#/components/schemas/CaptureStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "Captures in descending creation order, limited to 100 by the current implementation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Capture" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Captures"],
        "summary": "Submit a capture",
        "operationId": "createCapture",
        "description": "Client-neutral alias of `POST /api/shortcut/captures`. Both routes use the shared capture request documented below; only their response envelopes differ. A paired `capture:write` device token is sufficient. Reusing `client_capture_id` for the same account makes the request idempotent.",
        "security": [{ "deviceToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/CaptureRequest" },
        "responses": {
          "200": {
            "description": "An idempotent retry found the existing capture.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CreateCaptureResponse" } }
            }
          },
          "201": {
            "description": "Capture created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CreateCaptureResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/ApiFailure" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/api/v1/captures/{id}": {
      "get": {
        "tags": ["Reserved full access"],
        "summary": "Get one capture (reserved)",
        "operationId": "getCapture",
        "description": "Requires a `full` token, which the public pairing flow does not currently issue.",
        "security": [{ "fullDeviceToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CaptureId" }],
        "responses": {
          "200": {
            "description": "Capture and attachment metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": { "data": { "$ref": "#/components/schemas/Capture" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CaptureNotFound" }
        }
      },
      "delete": {
        "tags": ["Reserved full access"],
        "summary": "Soft-delete a capture (reserved)",
        "operationId": "deleteCapture",
        "description": "Marks a capture as deleted. Requires a `full` token, which the public pairing flow does not currently issue.",
        "security": [{ "fullDeviceToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CaptureId" }],
        "responses": {
          "200": {
            "description": "Capture marked deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" },
                "example": { "status": "deleted" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CaptureNotFound" }
        }
      }
    },
    "/api/v1/captures/{id}/archive": {
      "post": {
        "tags": ["Reserved full access"],
        "summary": "Archive a capture (reserved)",
        "operationId": "archiveCapture",
        "description": "Marks a capture as archived. Requires a `full` token, which the public pairing flow does not currently issue.",
        "security": [{ "fullDeviceToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CaptureId" }],
        "responses": {
          "200": {
            "description": "Capture marked archived.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" },
                "example": { "status": "archived" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CaptureNotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "catch_device_…",
        "description": "Device token returned once by a successful pairing request. The issued `capture:write` scope can submit captures."
      },
      "fullDeviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "catch_device_…",
        "description": "Reserved `full` token. The application currently has no public flow that issues one."
      }
    },
    "parameters": {
      "CaptureId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Server-generated capture UUID.",
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Supported by both capture aliases and used as `client_capture_id` when that body field is absent. For an iOS Shortcut form, supplying `client_capture_id` in the body is usually simpler. If neither value is supplied, Catch generates a random ID.",
        "schema": { "type": "string", "maxLength": 128 }
      }
    },
    "requestBodies": {
      "PairingRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PairingRequest" }
          },
          "application/x-www-form-urlencoded": {
            "schema": { "$ref": "#/components/schemas/PairingRequest" }
          }
        }
      },
      "ExtensionPairingStartRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtensionPairingStartRequest" } } }
      },
      "ExtensionPairingExchangeRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtensionPairingExchangeRequest" } } }
      },
      "CaptureRequest": {
        "required": true,
        "description": "Shared request body for `POST /api/shortcut/captures` and `POST /api/v1/captures`. Choose `type` for the content being stored, not for the process that produced it. For example, dictated speech that has already been converted to a transcript is a `text` capture whose transcript belongs in `text`.",
        "content": {
          "multipart/form-data": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/CaptureInput" },
                {
                  "type": "object",
                  "properties": {
                    "attachments[]": {
                      "type": "array",
                      "items": { "type": "string", "format": "binary" },
                      "description": "Optional files. Repeat this field to send multiple files. Each file is limited to 15 MiB by the example configuration; allowed MIME types depend on the installation."
                    }
                  }
                }
              ]
            }
          },
          "application/json": {
            "schema": { "$ref": "#/components/schemas/CaptureInput" }
          }
        }
      }
    },
    "responses": {
      "InvalidPairingCode": {
        "description": "Pairing code is invalid, expired, or has already been consumed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": {
              "error": {
                "code": "invalid_pairing_code",
                "message": "The pairing code is invalid."
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Bearer token is absent, invalid, or lacks the required permission.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": {
              "error": {
                "code": "unauthorized",
                "message": "A token with the required permission is needed."
              }
            }
          }
        }
      },
      "ShortcutUnauthorized": {
        "description": "Bearer token is absent, invalid, or lacks `capture:write`.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
            "example": { "error": "A token with the required permission is needed." }
          }
        }
      },
      "ValidationFailed": {
        "description": "Capture fields failed validation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationError" }
          }
        }
      },
      "ShortcutValidationFailed": {
        "description": "Capture fields failed validation. Messages are flattened for iOS Shortcuts.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
            "example": { "error": "Provide text, a URL, or an attachment." }
          }
        }
      },
      "CaptureNotFound": {
        "description": "No capture with that ID belongs to the authenticated account.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "error": { "code": "not_found", "message": "Capture not found." } }
          }
        }
      },
      "ApiFailure": {
        "description": "The server could not complete the operation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "ShortcutFailure": {
        "description": "The server could not complete the Shortcut operation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
            "example": { "error": "The request could not be completed." }
          }
        }
      },
      "DatabaseUnavailable": {
        "description": "Database is unconfigured or unavailable.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "error": { "code": "database_unavailable", "message": "Database is not configured or unavailable." } }
          }
        }
      },
      "ShortcutDatabaseUnavailable": {
        "description": "Database is unconfigured or unavailable.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ShortcutResponse" },
            "example": { "error": "Database is not configured or unavailable." }
          }
        }
      }
    },
    "schemas": {
      "PairingRequest": {
        "type": "object",
        "required": ["pairing_code"],
        "properties": {
          "pairing_code": {
            "type": "string",
            "minLength": 10,
            "maxLength": 11,
            "pattern": "^[1-9][0-9]{4}[ -]?[0-9]{5}$",
            "description": "10-digit code created for a setup-state device. It expires after 15 minutes. The optional displayed space or a hyphen is ignored.",
            "example": "12345 67890"
          }
        }
      },
      "PairingResponse": {
        "type": "object",
        "required": ["device_token", "token_type", "capture_endpoint"],
        "properties": {
          "device_token": { "type": "string", "example": "catch_device_example-token" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "capture_endpoint": { "type": "string", "format": "uri", "example": "https://catch.sorkos.net/api/shortcut/captures" }
        }
      },
      "ExtensionPairingStartRequest": {
        "type": "object",
        "required": ["code_challenge"],
        "properties": {
          "code_challenge": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$", "description": "Base64url-encoded SHA-256 digest of the random verifier retained by the extension." }
        }
      },
      "ExtensionPairingExchangeRequest": {
        "type": "object",
        "required": ["code_verifier"],
        "properties": {
          "code_verifier": { "type": "string", "minLength": 43, "description": "Random verifier retained locally by the extension. It is never included in the approval URL." }
        }
      },
      "ExtensionPairingStartResponse": {
        "type": "object",
        "required": ["request_id", "device_name", "platform", "expires_at", "pair_url"],
        "properties": {
          "request_id": { "type": "string", "pattern": "^[0-9a-f]{48}$" },
          "device_name": { "type": "string" },
          "platform": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "pair_url": { "type": "string", "format": "uri", "description": "User-facing approval URL. It contains only the short-lived request ID." }
        }
      },
      "ExtensionPairingResponse": {
        "type": "object",
        "required": ["status", "device_token", "token_type", "device", "capture_endpoint"],
        "properties": {
          "status": { "type": "string", "enum": ["connected"] },
          "device_token": { "type": "string", "example": "catch_device_example-token" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "device": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
          "capture_endpoint": { "type": "string", "format": "uri", "example": "https://catch.sorkos.net/api/v1/captures" }
        }
      },
      "ShortcutResponse": {
        "description": "Mutually exclusive flat response for iOS Shortcuts.",
        "oneOf": [
          { "$ref": "#/components/schemas/ShortcutSuccess" },
          { "$ref": "#/components/schemas/ShortcutError" }
        ]
      },
      "ShortcutSuccess": {
        "type": "object",
        "required": ["result"],
        "additionalProperties": false,
        "properties": {
          "result": { "type": "string", "minLength": 1, "description": "The operation's scalar result." }
        }
      },
      "ShortcutError": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": { "type": "string", "minLength": 1, "description": "A human-readable error message." }
        }
      },
      "CaptureInput": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "client_capture_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional stable ID generated by the client, unique for this logical capture. A non-blank body value takes precedence over `Idempotency-Key`. Save and reuse it when retrying the same capture to avoid duplicates. If both are absent, Catch generates a random `client_capture_...` value. Device tokens (`catch_device_...`) are never accepted as capture IDs.",
            "example": "64e2943d-66e3-49f9-82b1-71612cc52f80"
          },
          "type": { "$ref": "#/components/schemas/CaptureType" },
          "title": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Optional human-readable heading. It does not replace the required content in `text`, `url`, or an attachment.",
            "example": "Project reminder"
          },
          "text": {
            "type": "string",
            "nullable": true,
            "description": "Primary textual content. Put typed text and voice-to-text transcripts here. A non-blank value satisfies the content requirement.",
            "example": "Review the proposal tomorrow morning."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Primary URL being captured. Use with `type=url`, or with `type=mixed` when the capture also has another primary content kind.",
            "example": "https://example.com/proposal"
          },
          "remote_attachment_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Public image URL to retrieve as an attachment. Catch rejects private or reserved network targets and enforces the configured attachment size and MIME allowlist. Intended for browser image context-menu captures."
          },
          "extracted_text": {
            "type": "string",
            "nullable": true,
            "description": "Optional machine-derived text that supplements the primary content, such as OCR from an image or a transcript retained alongside an audio attachment. Do not use it for a voice-to-text-only capture: put that transcript in `text`. This field alone does not satisfy the content requirement.",
            "example": "Recognized text from the attached image or audio."
          },
          "source": {
            "type": "string",
            "maxLength": 80,
            "default": "web",
            "description": "Optional client/channel label for provenance. It is not an enum; use a stable value such as `ios-shortcut`. If omitted, the server stores `web`.",
            "example": "ios-shortcut"
          },
          "metadata": {
            "nullable": true,
            "description": "Optional client-defined structured details. Send a JSON object with an application/json request, or a JSON-encoded object string with multipart/form-data. Metadata is stored but does not satisfy the content requirement.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true,
                "example": { "device": "iPhone", "shortcut_version": "1.0" }
              },
              {
                "type": "string",
                "example": "{\"device\":\"iPhone\",\"shortcut_version\":\"1.0\"}"
              }
            ]
          }
        },
        "description": "At least one of `text`, `url`, or a multipart attachment must contain data. A title, `extracted_text`, or metadata alone is not accepted. Voice-to-text example: `type=text`, `text=<dictated transcript>`, and `source=ios-shortcut`. Supplying a stable `client_capture_id` remains useful only for clients that can retry with the same value."
      },
      "CaptureType": {
        "type": "string",
        "enum": ["text", "url", "image", "audio", "file", "mixed"],
        "description": "Required classification of the primary stored content: `text` for typed or dictated text (including a voice-to-text transcript); `url` for a link; `image` for image attachment(s); `audio` for an actual audio attachment; `file` for other attachment(s); or `mixed` when multiple primary kinds are intentionally combined. The type describes what is stored, not how it was obtained.",
        "example": "text"
      },
      "CaptureStatus": {
        "type": "string",
        "enum": ["inbox", "archived", "deleted"],
        "default": "inbox"
      },
      "CreateCaptureResponse": {
        "type": "object",
        "required": ["id", "catch_number", "status", "created_at", "matched_rules"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "catch_number": { "$ref": "#/components/schemas/CatchNumber" },
          "status": { "type": "string", "enum": ["created", "existing"] },
          "created_at": { "type": "string", "format": "date-time" },
          "matched_rules": { "type": "integer", "example": 0 }
        }
      },
      "Capture": {
        "type": "object",
        "required": ["id", "catch_number", "client_capture_id", "type", "source", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "catch_number": { "$ref": "#/components/schemas/CatchNumber" },
          "client_capture_id": { "type": "string" },
          "type": { "$ref": "#/components/schemas/CaptureType" },
          "title": { "type": "string", "nullable": true },
          "text": { "type": "string", "nullable": true },
          "url": { "type": "string", "nullable": true },
          "extracted_text": { "type": "string", "nullable": true },
          "source": { "type": "string" },
          "metadata_json": { "type": "object", "nullable": true, "additionalProperties": true },
          "status": { "$ref": "#/components/schemas/CaptureStatus" },
          "attachment_count": { "type": "integer", "minimum": 0 },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attachment" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "archived_at": { "type": "string", "format": "date-time", "nullable": true },
          "deleted_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "CatchNumber": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "readOnly": true,
        "description": "Immutable, monotonically increasing number scoped to the owning user. It is intended for human references such as `Catch #334`; the UUID remains the globally unique technical identifier.",
        "example": 334
      },
      "Attachment": {
        "type": "object",
        "required": ["id", "original_name", "mime_type", "size_bytes", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "original_name": { "type": "string" },
          "mime_type": { "type": "string" },
          "size_bytes": { "type": "integer", "format": "int64" },
          "width": { "type": "integer", "nullable": true },
          "height": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/CaptureStatus" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "ValidationError": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiError" },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      },
      "Health": {
        "type": "object",
        "required": ["status", "database", "time"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "database": { "type": "string", "enum": ["connected", "unavailable"] },
          "time": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
