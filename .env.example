APP_ENV=production
APP_DEBUG=false
APP_URL=https://catch.example.com
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=Europe/Berlin
PRERELEASE=false
PRERELEASE_ALLOWED_SORKOS_USER_ID=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=catch
DB_USER=catch
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_SECURE=true
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf,text/plain,audio/mpeg,audio/mp4

SORKOS_BASE_URL=https://auth.example.com
SORKOS_CLIENT_ID=
SORKOS_CLIENT_SECRET=
SORKOS_REDIRECT_URI=https://catch.example.com/auth/callback
SORKOS_POST_LOGOUT_REDIRECT_URI=https://catch.example.com/login
SORKOS_SCOPE="profile email"
SORKOS_LANGUAGE=de
SORKOS_TLS_VERIFY=true
