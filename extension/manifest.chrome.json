{
  "manifest_version": 3,
  "name": "Catch",
  "version": "1.0.0",
  "description": "Capture pages, selections, links, and screenshots to Catch.",
  "permissions": ["activeTab", "alarms", "contextMenus", "storage", "tabs"],
  "host_permissions": ["https://catch.sorkos.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Catch this page",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/selection-markdown.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "setup/setup.html",
    "open_in_tab": true
  }
}
